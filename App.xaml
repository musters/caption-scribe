<Application x:Class="CaptionScribe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             SessionEnding="OnSessionEnding"
             Exit="OnExit">
    <Application.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                Background="#F3F3F3" BorderBrush="#C8C8C8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5BA0E0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5BA0E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CDE6FA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A85D0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9A9A9A" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DADADA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="CaptionScribe.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Scribe — About"
        Height="400" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#5B2A91" TextAlignment="Left" LineStackingStrategy="BlockLineHeight" LineHeight="13" xml:space="preserve"><Run Text="   ____            _   _               ____            _ _          "/><LineBreak/><Run Text="  / ___|__ _ _ __ | |_(_) ___  _ __   / ___|  ___ _ __(_) |__   ___ "/><LineBreak/><Run Text=" | |   / _` | '_ \| __| |/ _ \| '_ \  \___ \ / __| '__| | '_ \ / _ \"/><LineBreak/><Run Text=" | |__| (_| | |_) | |_| | (_) | | | |  ___) | (__| |  | | |_) |  __/"/><LineBreak/><Run Text="  \____\__,_| .__/ \__|_|\___/|_| |_| |____/ \___|_|  |_|_.__/ \___|"/><LineBreak/><Run Text="            |_| "/></TextBlock>
        <TextBlock Text="by Musters" Margin="0,10,0,0" Foreground="#555" FontSize="12" />
        <TextBlock Text="{Binding Version}" Margin="0,4,0,0" Foreground="#555" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Captures live captions and chats from meetings and conversations by using local Windows OCR and stitching them into a running transcript. No cloud, no accounts." />
        <TextBlock Margin="0,8,0,0" Foreground="#555" FontSize="12" Text="MIT License © 2026 Musters Consulting" />
        <TextBlock Text="{Binding AutoSavePath}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#777" FontSize="11" />
        <Button Style="{StaticResource DialogButton}" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" ToolTip="Close" />
    </StackPanel>
</Window>

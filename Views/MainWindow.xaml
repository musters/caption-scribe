<Window x:Class="CaptionScribe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Scribe"
        Height="392" Width="680"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F0F0F0"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0C0C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B0B0B0" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material Design Icons (Pictogrammers, Apache 2.0). Swap the path data for your own art anytime. -->
        <Geometry x:Key="IconNew">F1 M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</Geometry>
        <Geometry x:Key="IconSave">F1 M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</Geometry>
        <Geometry x:Key="IconClear">F1 M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="IconCopy">F1 M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</Geometry>
        <Geometry x:Key="IconPlay">F1 M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="IconPause">F1 M14,19H18V5H14M6,19H10V5H6V19Z</Geometry>
        <Geometry x:Key="IconStop">F1 M18,18H6V6H18V18Z</Geometry>
        <Geometry x:Key="IconHighlight">F1 M19,3H15V5H19V9H21V5C21,3.89 20.1,3 19,3M19,19H15V21H19A2,2 0 0,0 21,19V15H19M5,15H3V19A2,2 0 0,0 5,21H9V19H5M5,5H9V3H5A2,2 0 0,0 3,5V9H5V5Z</Geometry>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#F0F0F0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button Style="{StaticResource ToolButton}" ToolTip="Highlight Capture Region — briefly outline it on screen" Command="{Binding HighlightCommand}">
                    <Path Data="{StaticResource IconHighlight}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="2,0,12,0" ToolTip="Select Capture Region" Command="{Binding SelectRegionCommand}">
                    <Grid Width="16" Height="16">
                        <Path Data="{StaticResource IconHighlight}" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        <TextBlock Text="S" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="New Scribe — clear and start a new transcript" Command="{Binding NewScribeCommand}">
                    <Path Data="{StaticResource IconNew}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Save Scribe to a file…" Command="{Binding SaveCommand}">
                    <Path Data="{StaticResource IconSave}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Clear the transcript" Command="{Binding ClearCommand}">
                    <Path Data="{StaticResource IconClear}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Copy the transcript to the clipboard" Command="{Binding CopyCommand}">
                    <Path Data="{StaticResource IconCopy}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="20,0,0,0" ToolTip="{Binding PlayPauseToolTip}" Command="{Binding PlayPauseCommand}">
                    <Path Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconPause}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Stop and save" Command="{Binding StopCommand}">
                    <Path Data="{StaticResource IconStop}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Button>
            </StackPanel>
            <Menu DockPanel.Dock="Left" Background="Transparent" FontSize="14">
            <MenuItem Header="_File">
                <MenuItem Header="_New Scribe" Command="{Binding NewScribeCommand}" />
                <MenuItem Header="_Save Scribe" Command="{Binding SaveCommand}" />
                <Separator />
                <MenuItem Header="_Active" IsCheckable="True" IsChecked="{Binding IsActive, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Clear" Command="{Binding ClearCommand}" />
                <MenuItem Header="Co_py" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Show All Output" IsCheckable="True" IsChecked="{Binding ShowAllOutput, Mode=TwoWay}" />
                <MenuItem Header="_Timestamps" IsCheckable="True" IsChecked="{Binding ShowTimestamps, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Highlight Capture Region" Command="{Binding HighlightCommand}" />
                <MenuItem Header="Select Capture _Region" Command="{Binding SelectRegionCommand}" />
                <MenuItem Header="Capture _Diagnostics…" Command="{Binding CaptureDiagnosticsCommand}" />
                <Separator />
                <MenuItem Header="Capture _Participants (experimental)" IsCheckable="True" IsChecked="{Binding EnableParticipantCapture, Mode=TwoWay}" />
                <MenuItem Header="_Settings" Command="{Binding SettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="_Help" Command="{Binding HelpCommand}" />
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
            </Menu>
            <TextBlock Text="{Binding RegionText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#888" Cursor="Hand" ToolTip="Click to set a new capture region"
                       MouseLeftButtonUp="OnRegionTextClick" />
        </DockPanel>

        <Grid DockPanel.Dock="Bottom" Margin="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Capture Status: " VerticalAlignment="Center" Foreground="#555" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#555" />
            </StackPanel>
            <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="8,0,8,4">
            <Border BorderBrush="#DDD" BorderThickness="1">
                <TextBox x:Name="TranscriptBox" IsReadOnly="True" Text="{Binding TranscriptText, Mode=OneWay}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="13" Padding="8" Background="#FAFAFA"
                         ScrollViewer.ScrollChanged="OnTranscriptScrollChanged" TextChanged="OnTranscriptTextChanged" />
            </Border>
            <Border Background="Transparent" Cursor="Hand"
                    Visibility="{Binding ShowIdleOverlay, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonUp="OnPlaceholderClick">
                <TextBlock Text="Press Space or Click here to start capture"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="16" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
